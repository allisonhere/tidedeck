# Maintainer: Allie Bayless <drbayless@gmail.com>
#
# Generated from packaging/aur/PKGBUILD.in by packaging/aur/render-pkgbuild.sh.
# Edit the template in the TideDeck repository, not this file.

pkgname=tidedeck-bin
pkgver=@PKGVER@
pkgrel=@PKGREL@
pkgdesc="A tiling terminal dashboard: weather, mail, git, system and plugins, built on TideUI"
arch=('x86_64' 'aarch64')
url="https://github.com/allisonhere/tidedeck"
license=('MIT')
provides=("tidedeck=$pkgver")
conflicts=('tidedeck')
optdepends=(
  'git: install plugins from the Plugins page'
  'wl-clipboard: copy on Wayland'
  'xclip: copy on X11'
  'xdg-utils: open links and files'
)
# Upstream ships a static, already-stripped binary; re-stripping it only
# produces an empty debug package.
options=('!strip' '!debug')

source=("LICENSE-$pkgver::$url/raw/v$pkgver/LICENSE")
source_x86_64=("$pkgname-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/tidedeck-linux-x86_64.tar.gz")
source_aarch64=("$pkgname-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/tidedeck-linux-aarch64.tar.gz")
sha256sums=('@SHA256_LICENSE@')
sha256sums_x86_64=('@SHA256_X86_64@')
sha256sums_aarch64=('@SHA256_AARCH64@')

package() {
  install -Dm755 "$srcdir/tidedeck-linux-$CARCH" "$pkgdir/usr/bin/tidedeck"
  install -Dm644 "$srcdir/LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
