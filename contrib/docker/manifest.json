{
  "schemaVersion": 1,
  "id": "tidedeck.docker",
  "name": "Containers",
  "version": "1.0.0",
  "author": "tidedeck",
  "license": "MIT",
  "description": "Docker containers, their state and health, read from docker ps.",
  "kinds": [
    "panel"
  ],
  "entryPoints": {
    "panel": [
      "./render.sh"
    ]
  },
  "panel": {
    "displayName": "Containers",
    "glyph": "\ud83d\udc33",
    "category": "System",
    "input": "filter",
    "copy": "id",
    "refreshSeconds": 10,
    "minWidth": 26,
    "minHeight": 5,
    "priority": 35,
    "schema": [
      {
        "key": "all",
        "type": "boolean",
        "label": "show stopped",
        "defaultValue": true
      },
      {
        "key": "filter",
        "type": "string",
        "label": "filter",
        "defaultValue": ""
      }
    ],
    "inputChars": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-/:"
  }
}
