{
  "schemaVersion": 1,
  "id": "tidedeck.mail",
  "name": "Mail",
  "version": "1.5.0",
  "author": "tidedeck",
  "license": "MIT",
  "description": "A preview of recent mail, read from TideMail's local cache.",
  "kinds": ["panel"],
  "entryPoints": { "panel": ["./render.sh"] },
  "panel": {
    "open": ["tidemail", "--open", "{id}"],
    "displayName": "Mail",
    "glyph": "\u2709",
    "category": "Mail",
    "refreshSeconds": 60,
    "minWidth": 26,
    "minHeight": 6,
    "priority": 55,
    "schema": [
      { "key": "account", "type": "string", "label": "account",
        "description": "Which account to preview. The list is read from your mailbox.",
        "placeholder": "every account", "defaultValue": "" },
      { "key": "mailbox", "type": "string", "label": "mailbox",
        "description": "Which mailbox to preview. Narrows to the chosen account.",
        "placeholder": "the inbox", "defaultValue": "" },
      { "key": "count", "type": "number", "label": "messages shown",
        "description": "How many messages the panel previews, 1 to 50.", "defaultValue": "6" },
      { "key": "unread", "type": "boolean", "label": "unread only", "defaultValue": false },
      { "key": "db", "type": "string", "label": "mail.db path",
        "description": "Blank uses TideMail's own location.", "defaultValue": "" }
    ]
  }
}
