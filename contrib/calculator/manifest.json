{
  "schemaVersion": 1,
  "id": "tidedeck.calculator",
  "name": "Calculator",
  "version": "2.0.0",
  "author": "tidedeck",
  "license": "MIT",
  "description": "A calculator you type into: it evaluates the expression and shows the result.",
  "kinds": ["panel"],
  "entryPoints": { "panel": ["./render.sh"] },
  "panel": {
    "displayName": "Calculator",
    "category": "Utilities",
    "refreshSeconds": 30,
    "minWidth": 22,
    "minHeight": 5,
    "priority": 30,
    "input": "expression",
    "inputChars": "0123456789.+-*/() ",
    "copy": "value",
    "schema": [
      { "key": "expression", "type": "string", "label": "expression", "defaultValue": "" }
    ]
  }
}
