      "license": "MIT",
      "description": "Plan usage and balances, read from the ai-usagebar binary.",
      "glyph": "🤖",
      "category": "AI",
      "kinds": [
        "panel"
      ],
      "source": "contrib/ai-usage",
      "install": "https://github.com/allisonhere/tidedeck#contrib/ai-usage",
      "refreshSeconds": 300,
      "minWidth": 22,
      "minHeight": 5,
      "priority": 45,
      "gauge": true,
      "spark": true,
      "settings": [
        {
          "key": "binary",
          "type": "string",
          "label": "ai-usagebar binary",
          "description": ""
        }
      ]
    },
    {
      "id": "tidedeck.docker",
      "name": "Containers",
      "displayName": "Containers",
      "version": "1.0.0",
      "author": "tidedeck",
      "license": "MIT",
      "description": "Docker containers, their state and health, read from docker ps.",
      "glyph": "🐳",
      "category": "System",
      "kinds": [
        "panel"
      ],
      "source": "contrib/docker",
      "install": "https://github.com/allisonhere/tidedeck#contrib/docker",
