      "minHeight": 5,
      "priority": 35,
      "gauge": false,
      "spark": false,
      "settings": [
        {
          "key": "all",
          "type": "boolean",
          "label": "show stopped",
          "description": ""
        },
        {
          "key": "filter",
          "type": "string",
          "label": "filter",
          "description": ""
        }
      ]
    },
    {
      "id": "tidedeck.favorites",
      "name": "Favorites",
      "displayName": "Favorites",
      "version": "2.0.0",
      "author": "tidedeck",
      "license": "MIT",
      "description": "A list of links you keep, with a form to add, change and remove them.",
      "glyph": "🔖",
      "category": "Favorites",
      "kinds": [
        "panel"
      ],
      "source": "contrib/favorites",
      "install": "https://github.com/allisonhere/tidedeck#contrib/favorites",
      "refreshSeconds": 60,
      "minWidth": 24,
      "minHeight": 5,
      "priority": 45,
      "gauge": false,
      "spark": false,
      "settings": [
        {
          "key": "path",
          "type": "string",
          "label": "list path",
          "description": "Where the list is kept. Blank uses the default location under your data directory."
        }
      ]
    },
    {
      "id": "tidedeck.mail",
      "name": "Mail",
      "displayName": "Mail",
      "version": "1.5.1",
      "author": "tidedeck",
      "license": "MIT",
      "description": "A preview of recent mail, read from TideMail's local cache.",
      "glyph": "📧",
      "category": "Mail",
      "kinds": [
        "panel"
      ],
      "source": "contrib/mail",
      "install": "https://github.com/allisonhere/tidedeck#contrib/mail",
      "refreshSeconds": 60,
      "minWidth": 26,
      "minHeight": 6,
      "priority": 55,
      "gauge": false,
      "spark": false,
      "settings": [
        {
          "key": "account",
          "type": "string",
          "label": "account",
          "description": "Which account to preview. The list is read from your mailbox."
        },
        {
          "key": "mailbox",
          "type": "string",
          "label": "mailbox",
          "description": "Which mailbox to preview. Narrows to the chosen account."
        },
        {
          "key": "count",
          "type": "number",
          "label": "messages shown",
          "description": "How many messages the panel previews, 1 to 50."
        },
        {
          "key": "unread",
          "type": "boolean",
          "label": "unread only",
          "description": ""
        },
        {
          "key": "db",
          "type": "string",
          "label": "mail.db path",
          "description": "Blank uses TideMail's own location."
        }
      ]
    },
    {
      "id": "tidedeck.obsidian",
      "name": "Obsidian",
      "displayName": "Obsidian",
      "version": "1.1.0",
      "author": "tidedeck",
      "license": "MIT",
      "description": "Search and edit notes in your Obsidian vault.",
      "glyph": "💎",
      "category": "Notes",
      "kinds": [
        "panel"
      ],
      "source": "contrib/obsidian",
      "install": "https://github.com/allisonhere/tidedeck#contrib/obsidian",
      "refreshSeconds": 30,
      "minWidth": 26,
      "minHeight": 4,
      "priority": 45,
      "gauge": false,
      "spark": false,
      "settings": [
        {
          "key": "vault",
          "type": "string",
          "label": "vault",
          "description": "Which vault to search. The list is read from Obsidian."
        },
        {
          "key": "query",
          "type": "string",
          "label": "search",
          "description": "What is typed in the pane; it filters the notes as you type."
        },
        {
          "key": "mode",
          "type": "choice",
          "label": "editor mode",
          "description": "Ripple's editing mode for editing a note."
        }
      ]
    },
    {
      "id": "tidedeck.pagepulse",
      "name": "PagePulse",
      "displayName": "PagePulse",
      "version": "1.0.0",
      "author": "tidedeck",
      "license": "MIT",
      "description": "Who is on your PagePulse site now, and the page they are reading.",
      "glyph": "📈",
      "category": "Analytics",
      "kinds": [
        "panel"
      ],
      "source": "contrib/pagepulse",
      "install": "https://github.com/allisonhere/tidedeck#contrib/pagepulse",
      "refreshSeconds": 60,
      "minWidth": 24,
      "minHeight": 5,
      "priority": 45,
      "gauge": false,
      "spark": false,
      "settings": [
        {
          "key": "url",
          "type": "string",
          "label": "PagePulse URL",
          "description": "Where your PagePulse install lives, for example https://stats.example.com."
        },
        {
          "key": "key",
          "type": "string",
          "label": "API key",
          "description": "A read key generated on PagePulse's Settings page. It is read-only."
        },
        {
          "key": "site",
          "type": "string",
          "label": "site",
          "description": "Which site to show. The list is read from PagePulse."
        },
        {
          "key": "preset",
          "type": "choice",
          "label": "period",
          "description": "The reporting period the totals cover."
        }
      ]
    }
  ]
}
